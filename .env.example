# ==================== DATABASE ====================
# Neon (recommended): sign up at https://neon.tech and copy the connection string.
# Local Postgres alternative: "postgresql://postgres:password@localhost:5432/learnify"
DATABASE_URL="postgresql://user:password@host:5432/learnify?sslmode=require"

# ==================== AUTH (NextAuth v5) ====================
# Generate a strong secret:
#   openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ==================== OAUTH (optional, staff roles only) ====================
# Learners must sign in with email + password (IESA LMS spec §3.1).
# Leave these blank unless you want OAuth available for Course Developers,
# Academy Admins, Marketers, Platform Owner, or Platform Support.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ==================== STRIPE ====================
# Use test-mode keys (sk_test_…, pk_test_…) during development.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ==================== CLOUDINARY ====================
# Sign up at https://cloudinary.com, create an unsigned upload preset.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ==================== APP ====================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==================== GEN-AI (Phase 7) ====================
# Leave blank until Phase 7. Used only when an Academy enables AI-assisted authoring.
ANTHROPIC_API_KEY=""

# ==================== EMAIL (Phase 4) ====================
# Leave blank until Phase 4 reminder emails / invoices are implemented.
EMAIL_FROM=""
RESEND_API_KEY=""

# ==================== CRON (Phase 4) ====================
# Shared secret verified by /api/cron/* routes.
CRON_SECRET=""
