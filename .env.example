# ==================== DATABASE ====================
# Neon (recommended): sign up at https://neon.tech and copy the connection string.
# Local Postgres alternative: "postgresql://postgres:password@localhost:5432/learnify"
DATABASE_URL="postgresql://user:password@host:5432/learnify?sslmode=require"

# ==================== AUTH (NextAuth v5) ====================
# Generate a strong secret:
#   openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ==================== OAUTH (optional, staff roles only) ====================
# Learners must sign in with email + password (IESA LMS spec §3.1).
# Leave these blank unless you want OAuth available for Course Developers,
# Academy Admins, Marketers, Platform Owner, or Platform Support.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ==================== STRIPE ====================
# Use test-mode keys (sk_test_…, pk_test_…) during development.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ==================== CLOUDINARY (media CDN — optional) ====================
# Cloudinary handles course thumbnails and lecture video uploads. When
# all five values below are set, the app:
#   - Uploads videos directly from the browser via signed URLs
#   - Auto-generates video thumbnails (no separate upload needed)
#   - Serves resized/optimized images on the public catalogue
#
# When Cloudinary is NOT configured, the app falls back to:
#   - Vercel Blob (production) if BLOB_READ_WRITE_TOKEN is set
#   - Local disk (/public/uploads) for dev only
# These fallbacks work but DO NOT auto-generate video thumbnails.
#
# Setup (5 minutes):
#   1. Sign up at https://cloudinary.com (free tier is fine).
#   2. Dashboard → "Product Environment Credentials" — copy the values:
#        Cloud Name, API Key, API Secret.
#   3. Settings (gear icon) → Upload → Upload presets → "Add upload preset":
#        - Name: e.g. `iesa-uploads`
#        - Signing Mode: Signed (recommended) or Unsigned
#        - Save and copy the preset name.
#   4. Fill in the five values below.
#   5. The two NEXT_PUBLIC_… values are the same as their counterparts —
#      duplicated because the browser-side upload form needs them.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Vercel Blob — production-friendly upload fallback when Cloudinary
# isn't configured. Auto-provisioned by linking a Blob store to your
# project in the Vercel dashboard (Storage → Create → Blob).
# BLOB_READ_WRITE_TOKEN=""

# ==================== APP ====================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==================== GEN-AI (Phase 7) ====================
# Global fallback Claude credential — used by every Academy that hasn't
# pasted its own token in /academy/settings. Accepts either a Console
# API key (sk-ant-…) or a Claude.ai subscription OAuth token (sk-ant-oat…).
ANTHROPIC_API_KEY=""

# Required as soon as any Academy stores its own Claude credential.
# Generate with: openssl rand -base64 32
# (32 bytes — used for AES-256-GCM encryption of per-tenant tokens.)
CREDENTIAL_ENCRYPTION_KEY=""

# ==================== EMAIL (Phase 4) ====================
# Leave blank until Phase 4 reminder emails / invoices are implemented.
EMAIL_FROM=""
RESEND_API_KEY=""

# ==================== CRON (Phase 4) ====================
# Shared secret verified by /api/cron/* routes.
CRON_SECRET=""
