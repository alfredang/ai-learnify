# ==================== DATABASE ====================
# Any PostgreSQL 15+ works. Production uses PostgreSQL 17 as a Coolify-managed
# container — copy its internal connection string from the Coolify database resource.
# Local Postgres alternative: "postgresql://postgres:password@localhost:5432/learnify"
DATABASE_URL="postgresql://user:password@host:5432/learnify?sslmode=require"

# ==================== AUTH (NextAuth v5) ====================
# Generate a strong secret:
#   openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Required behind a reverse proxy (Traefik on Coolify) so NextAuth trusts the Host header.
AUTH_TRUST_HOST=true

# ==================== OAUTH (optional, staff roles only) ====================
# Learners must sign in with email + password (IESA LMS spec §3.1).
# Leave these blank unless you want OAuth available for Course Developers,
# Academy Admins, Marketers, Platform Owner, or Platform Support.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ==================== STRIPE ====================
# Use test-mode keys (sk_test_…, pk_test_…) during development.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ==================== CLOUDINARY (media CDN — optional) ====================
# Cloudinary handles course thumbnails and lecture video uploads. When
# all five values below are set, the app:
#   - Uploads videos directly from the browser via signed URLs
#   - Auto-generates video thumbnails (no separate upload needed)
#   - Serves resized/optimized images on the public catalogue
#
# When Cloudinary is NOT configured, files are stored on local disk under
# STORAGE_DIR (see below) and served by the /uploads/[...path] route.
# This fallback works but DOES NOT auto-generate video thumbnails.
#
# Setup (5 minutes):
#   1. Sign up at https://cloudinary.com (free tier is fine).
#   2. Dashboard → "Product Environment Credentials" — copy the values:
#        Cloud Name, API Key, API Secret.
#   3. Settings (gear icon) → Upload → Upload presets → "Add upload preset":
#        - Name: e.g. `iesa-uploads`
#        - Signing Mode: Signed (recommended) or Unsigned
#        - Save and copy the preset name.
#   4. Fill in the five values below.
#   5. The two NEXT_PUBLIC_… values are the same as their counterparts —
#      duplicated because the browser-side upload form needs them.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ==================== LOCAL STORAGE ====================
# Root for uploads and generated SCORM packages when Cloudinary is absent.
# In the Docker image this is /app/storage, mounted as a persistent volume.
STORAGE_DIR="./storage"

# ==================== APP ====================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==================== GEN-AI (Phase 7) ====================
# Fallback order: OpenAI (primary) → DeepSeek (automatic fallback when OpenAI
# is unset or fails). Academies can override these per tenant in
# Academy Settings → Integrations → AI Provider.
#
# OpenAI — EITHER an API key …
OPENAI_API_KEY=""
# … OR ChatGPT OAuth (access token required; refresh token + account id optional,
# e.g. the `tokens` block from ~/.codex/auth.json).
OPENAI_OAUTH_ACCESS_TOKEN=""
OPENAI_OAUTH_REFRESH_TOKEN=""
OPENAI_ACCOUNT_ID=""
# Model override (default gpt-6.1-sol).
OPENAI_MODEL=""

# DeepSeek V4.1 Flash — automatic fallback provider.
DEEPSEEK_API_KEY=""
# Defaults: https://api.deepseek.com and deepseek-flash
DEEPSEEK_BASE_URL=""
DEEPSEEK_MODEL=""

# Required as soon as any Academy stores its own AI credential.
# Generate with: openssl rand -base64 32
# (32 bytes — used for AES-256-GCM encryption of per-tenant tokens.)
CREDENTIAL_ENCRYPTION_KEY=""

# ==================== EMAIL (Phase 4) ====================
# Leave blank until Phase 4 reminder emails / invoices are implemented.
EMAIL_FROM=""
RESEND_API_KEY=""

# ==================== CRON (Phase 4) ====================
# Shared secret verified by /api/cron/* routes. Your scheduler (Coolify
# scheduled task or system cron) must send `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""
